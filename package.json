{
  "name": "mimetics-dsh-weekly-report",
  "version": "1.3.0",
  "description": "Harness (dsh) 工具插件：generate_weekly_report —— 在对话框里说一句「帮我生成本周周报」，即生成固定四模块的 Markdown 周报；内置流水线，装上即用。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "pipeline",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "link-test": "node test/link-test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "weekly-report",
    "report",
    "automation"
  ],
  "license": "MIT",
  "author": "广州永摹纪智能科技有限公司",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimetics-ai/mimetics-dsh-weekly-report.git"
  },
  "homepage": "https://github.com/mimetics-ai/mimetics-dsh-weekly-report#readme",
  "bugs": {
    "url": "https://github.com/mimetics-ai/mimetics-dsh-weekly-report/issues"
  }
}
